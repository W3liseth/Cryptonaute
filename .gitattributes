# Les scripts shell doivent garder des fins de ligne LF (Linux, macOS, paquets).
*.sh                      text eol=lf
packaging/macos/scripts/* text eol=lf
# Scripts et hooks Windows.
*.ps1                     text eol=crlf
*.nsh                     text eol=crlf
# Binaires fournis.
*.dll                     binary
*.ico                     binary
*.png                     binary
